{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "starthn",
  "account_id": "14e66a44c223436e076dbd6073c78d98",
  "compatibility_date": "2026-04-01",
  "compatibility_flags": ["nodejs_compat_v2"],
  "main": "src/server.ts",
  "routes": [
    { "pattern": "starthn.ba/*", "zone_name": "starthn.ba" },
    { "pattern": "www.starthn.ba/*", "zone_name": "starthn.ba" }
  ],
  "assets": {
    "binding": "ASSETS"
  },
  "vars": {
    "API_ORIGIN": "https://starthn-api-prod.azurewebsites.net",
    "AZURE_BLOB_ORIGIN": "https://starthnwebprod.blob.core.windows.net",
    "D1_PRIMARY": "true",
    "ADMIN_EMAILS": "hamza.abdagic@horizon-tech.io,selma.hadzic@starthn.ba",
    "MAINTENANCE_MODE": "false",
    // Set to "true" to close signups: blocks /register AND first-time OAuth
    // account creation. Existing users can still sign in.
    "DISABLE_REGISTRATION": "true",
    "JWT_ISSUER": "starthn",
    "JWT_AUDIENCE": "starthn-frontend",
    // OIDC idToken verification (oauth-verify.ts). PUBLIC identifiers — client/tenant
    // IDs are not secrets (the client ID ships in the frontend bundle; the tenant ID
    // is in the OIDC issuer URL). App reg: "StartHN Microsoft Login" (single-tenant /
    // AzureADMyOrg) in the StartHN Entra tenant aa722524.
    "MICROSOFT_CLIENT_ID": "bcabd55c-a414-4cc0-b785-32657356c959",
    "MICROSOFT_TENANT_ID": "aa722524-5f12-410b-b06c-d5a8d54b1ddf"
    // JWT_SECRET is set via `npx wrangler secret put JWT_SECRET` (not here — sensitive)
    // GOOGLE_CLIENT_ID intentionally unset — no Google OAuth app is configured yet, so
    // Google login fails closed (secure) until a real client ID is added here.
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "starthn-db",
      "database_id": "3be8b3ef-b0b9-4f54-9950-ba168c757cde",
      "migrations_dir": "src/server/db/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMG_CACHE",
      "bucket_name": "starthn-img-cache"
    }
  ],
  "queues": {
    "producers": [
      { "binding": "IMG_WRITE_QUEUE", "queue": "starthn-img-writes" }
    ],
    "consumers": [
      {
        "queue": "starthn-img-writes",
        "max_retries": 3,
        "dead_letter_queue": "starthn-img-writes-dlq"
      }
    ]
  }
}
