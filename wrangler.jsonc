{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "starthn",
  "account_id": "14e66a44c223436e076dbd6073c78d98",
  "compatibility_date": "2026-04-01",
  "compatibility_flags": ["nodejs_compat_v2"],
  "main": "src/server.ts",
  "assets": {
    "binding": "ASSETS"
  },
  "vars": {
    "API_ORIGIN": "https://starthn-api-prod.azurewebsites.net",
    "AZURE_BLOB_ORIGIN": "https://starthnwebprod.blob.core.windows.net",
    "D1_PRIMARY": "true",
    "ADMIN_EMAILS": "",
    "MAINTENANCE_MODE": "false"
    // JWT_SECRET is set via `npx wrangler secret put JWT_SECRET` (not here — sensitive)
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "starthn-db",
      "database_id": "3be8b3ef-b0b9-4f54-9950-ba168c757cde",
      "migrations_dir": "src/server/db/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMG_CACHE",
      "bucket_name": "starthn-img-cache"
    }
  ],
  "queues": {
    "producers": [
      { "binding": "IMG_WRITE_QUEUE", "queue": "starthn-img-writes" }
    ],
    "consumers": [
      {
        "queue": "starthn-img-writes",
        "max_retries": 3,
        "dead_letter_queue": "starthn-img-writes-dlq"
      }
    ]
  }
}
