# Headers for static files (Workers Assets). They never apply to responses
# the Worker generates: src/server/security-headers.ts sends the same
# security set for pages, and src/seo-public-files.test.ts keeps both equal.
# A header set by two matching rules is joined with a comma, so only /*
# sets the security headers and only the path rules set Cache-Control.
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: frame-ancestors 'self'
/assets/*
  Cache-Control: public, max-age=31536000, immutable
# Site images: a year, immutable. Never change one of these files in place:
# save the new version under a new name (e.g. slide-3-1440-v2.webp) and point
# the page at it, or returning visitors keep the old file for a year.
/hero/*
  Cache-Control: public, max-age=31536000, immutable
/pages/*
  Cache-Control: public, max-age=31536000, immutable
/clients/*
  Cache-Control: public, max-age=31536000, immutable
/testimonials/*
  Cache-Control: public, max-age=31536000, immutable
/promos/*
  Cache-Control: public, max-age=31536000, immutable
/certificates/*
  Cache-Control: public, max-age=31536000, immutable
/why-start-hn*
  Cache-Control: public, max-age=31536000, immutable
/about-*
  Cache-Control: public, max-age=31536000, immutable
/logo-*
  Cache-Control: public, max-age=31536000, immutable
# App icons and favicons: 30 days (browsers and Google fetch them by fixed
# names from the manifest and the head). Give a changed file a new name.
/icon-*
  Cache-Control: public, max-age=2592000
/favicon-*
  Cache-Control: public, max-age=2592000
/apple-touch-icon.png
  Cache-Control: public, max-age=2592000
# Non-ASCII text (Bosnian names): without a charset, clients that default
# text/* to ISO-8859-1 garble it.
/llms.txt
  Content-Type: text/plain; charset=utf-8
